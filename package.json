{
  "name": "earguards",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "env -u CLOUDFLARE_ENV vinext-cloudflare deploy --name earguards --config dist/server/wrangler.json",
    "deploy:vinext": "env -u CLOUDFLARE_ENV vinext-cloudflare deploy --name earguards --config dist/server/wrangler.json",
    "deploy:preview": "vinext-cloudflare deploy --config dist/server/wrangler.json --preview"
  },
  "dependencies": {
    "@netlify/plugin-nextjs": "^5.15.11",
    "@vinext/cloudflare": "^1.0.0-beta.9",
    "next": "^16.2.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.0.0-beta.11"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "vite": "^8.3.0",
    "wrangler": "^4.136.3"
  },
  "type": "module"
}
