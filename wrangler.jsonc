{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "earguards",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  // workers.dev only. Do not add routes or custom domains for earguards.com / www.
  // Apex and www stay on Bolt until DNS cutover is explicitly approved.
  "workers_dev": true,
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "env": {
    "preview": {
      "name": "earguards-preview",
      "workers_dev": true,
    },
  },
}
