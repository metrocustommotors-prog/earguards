{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "earguards",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  // Production (`npm run deploy`) publishes this top-level Worker.
  // Name is `earguards` (no environment suffix). workers.dev stays enabled.
  // There are no routes or custom domains here, so this deploy does not change
  // earguards.com DNS or mail. Apex and www stay on Bolt until cutover.
  //
  // Do not use `npm run deploy:preview` for production. That build bakes the
  // preview name `earguards-preview` into dist/server/wrangler.json (no env
  // block). `--preview` then runs `wrangler deploy --env preview`, and Wrangler
  // appends `-preview` again, publishing `earguards-preview-preview`
  // (https://earguards-preview-preview.friscolounge.workers.dev).
  //
  // Custom domains are a separate step. See README "Cloudflare Workers".
  // After the Bolt apex/www hostname records are removed, uncomment and redeploy:
  // "routes": [
  //   { "pattern": "earguards.com", "custom_domain": true, "zone_name": "earguards.com" },
  //   { "pattern": "www.earguards.com", "custom_domain": true, "zone_name": "earguards.com" }
  // ],
  "workers_dev": true,
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "env": {
    "preview": {
      "name": "earguards-preview",
      "workers_dev": true,
    },
  },
}
